from pathlib import Path

import pytest

from jarvis.core.agent_service import AgentService
from jarvis.models.base import (
    ModelProvider,
    ModelRequest,
    ModelResponse,
    ModelToolCall,
)
from jarvis.security.capabilities import Capability
from jarvis.security.policy import PermissionPolicy
from jarvis.tools.executor import (
    PermissionDeniedError,
    ToolExecutor,
)
from jarvis.tools.list_directory import (
    ListDirectoryTool,
)
from jarvis.tools.registry import ToolRegistry
from jarvis.tools.service import ToolService


class NormalResponseProvider(
    ModelProvider
):
    """
    Fake model used for testing a request
    that does NOT require a tool.
    """

    name = "test"

    def generate(
        self,
        request: ModelRequest,
    ) -> ModelResponse:
        del request

        return ModelResponse(
            text="Hello from JARVIS",
            provider=self.name,
            model="test-model",
        )


class ToolCallingProvider(
    ModelProvider
):
    """
    Fake model that always requests
    list_directory.
    """

    name = "test"

    def generate(
        self,
        request: ModelRequest,
    ) -> ModelResponse:
        # Make sure the agent actually supplied
        # available tool definitions.
        assert request.tools

        return ModelResponse(
            text="",
            provider=self.name,
            model="test-model",
            tool_calls=[
                ModelToolCall(
                    name="list_directory",
                    arguments={
                        "path": ".",
                    },
                )
            ],
        )


def build_tool_service(
    workspace: Path,
    *,
    allow_read: bool,
) -> ToolService:
    """
    Build a real ToolService for the tests.

    This means the tests use the same permission
    and execution path as the real application.
    """

    registry = ToolRegistry()

    registry.register(
        ListDirectoryTool(
            workspace,
        )
    )

    allowed: set[Capability] = set()

    if allow_read:
        allowed.add(
            Capability.READ_FILE
        )

    policy = PermissionPolicy(
        allowed=allowed,
    )

    executor = ToolExecutor(
        policy
    )

    return ToolService(
        registry,
        executor,
    )


def test_agent_returns_normal_model_response(
    tmp_path: Path,
):
    """
    Normal conversation should return the
    model response when no tool is needed.
    """

    tool_service = build_tool_service(
        tmp_path,
        allow_read=True,
    )

    agent = AgentService(
        model_provider=NormalResponseProvider(),
        tool_service=tool_service,
    )

    result = agent.run(
        "Hello"
    )

    assert result == "Hello from JARVIS"


def test_agent_executes_requested_tool(
    tmp_path: Path,
):
    """
    When the model requests list_directory,
    JARVIS should execute the REAL registered
    tool and return its actual result.
    """

    file_path = (
        tmp_path / "hello.txt"
    )

    file_path.write_text(
        "Hello",
        encoding="utf-8",
    )

    tool_service = build_tool_service(
        tmp_path,
        allow_read=True,
    )

    agent = AgentService(
        model_provider=ToolCallingProvider(),
        tool_service=tool_service,
    )

    result = agent.run(
        "What files are in my workspace?"
    )

    assert "hello.txt" in result


def test_agent_cannot_bypass_permission_policy(
    tmp_path: Path,
):
    """
    Most important security test:

    Even when the AI requests a valid tool,
    JARVIS must reject it when the required
    capability is disabled.
    """

    tool_service = build_tool_service(
        tmp_path,
        allow_read=False,
    )

    agent = AgentService(
        model_provider=ToolCallingProvider(),
        tool_service=tool_service,
    )

    with pytest.raises(
        PermissionDeniedError,
    ):
        agent.run(
            "What files are in my workspace?"
        )