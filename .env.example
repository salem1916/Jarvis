# Add these to your existing .env. Never replace existing credentials with this file.
# Set the key locally; do not paste it into a chat or commit it.
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_MODEL=gpt-4.1-mini
JARVIS_PREFER_CLOUD_REASONING=true

# Local inference on this PC or your own Ollama workstation endpoint.
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3.5:4b

# On by default in the desktop runtime. Keep data under the application state folder.
JARVIS_PERSIST_PERSONAL_MEMORY=true
